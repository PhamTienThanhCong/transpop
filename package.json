{
  "name": "transpop",
  "private": true,
  "description": "TransPop — Select to translate. Open-source Chrome extension (Manifest V3): select any word or phrase to translate it instantly.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "i18n": "node scripts/build-locales.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test \"tests/**/*.test.{js,mjs}\"",
    "package": "bash scripts/package.sh",
    "dev": "node scripts/dev-server.mjs",
    "icons": "bash store-assets/render.sh"
  }
}
